# ============================================================
# TRADING BOT - ENVIRONMENT CONFIGURATION EXAMPLE
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ============================================================

# --- Broker Configuration ---
BROKER_NAME=paper                        # paper | alpaca | oanda | interactive_brokers
BROKER_API_KEY=your_api_key_here
BROKER_SECRET_KEY=your_secret_key_here
BROKER_BASE_URL=https://paper-api.alpaca.markets
BROKER_MODE=demo                         # demo | live

# --- Trading Configuration ---
DEFAULT_SYMBOL=XAUUSD                    # XAUUSD | NAS100 | SPX500
DEFAULT_TIMEFRAME=H1                     # M1 | M5 | M15 | H1 | H4 | D1
DEFAULT_RISK_PERCENT=1.0                 # Risk per trade as % of capital
DEFAULT_LOT_SIZE=0.01
MAX_DAILY_LOSS_PERCENT=3.0               # Max daily drawdown before bot stops
MAX_OPEN_POSITIONS=3

# --- Strategy Parameters ---
EMA_FAST=21
EMA_SLOW=50
ATR_PERIOD=14
ATR_MULTIPLIER=2.0                       # Trailing stop ATR multiplier
MIN_CANDLE_BODY_PERCENT=0.3              # Filter small candles (% of ATR)
RSI_PERIOD=14
RSI_OVERBOUGHT=70
RSI_OVERSOLD=30

# --- Application ---
LOG_LEVEL=INFO                           # DEBUG | INFO | WARNING | ERROR
DB_PATH=trading_bot.db
TICK_INTERVAL_SECONDS=5                  # How often to poll for new data
